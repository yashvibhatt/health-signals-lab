<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}{% endblock %}</title>
<style>
  :root {
    color-scheme: light;
    --surface: #fcfcfb; --surface-2: #f4f3f0; --border: #e4e3df;
    --text: #0b0b0b; --text-2: #52514e; --accent: #2a78d6;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      color-scheme: dark;
      --surface: #1a1a19; --surface-2: #232322; --border: #383835;
      --text: #f0efec; --text-2: #c3c2b7; --accent: #3987e5;
    }
  }
  :root[data-theme="dark"] {
    color-scheme: dark;
    --surface: #1a1a19; --surface-2: #232322; --border: #383835;
    --text: #f0efec; --text-2: #c3c2b7; --accent: #3987e5;
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--surface); color: var(--text);
         font: 15px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
  main { max-width: 980px; margin: 0 auto; padding: 32px 16px 64px; }
  h1 { font-size: 1.6rem; margin: 0 0 4px; }
  h2 { font-size: 1.15rem; margin: 36px 0 10px; padding-bottom: 6px; border-bottom: 1px solid var(--border); }
  .meta { color: var(--text-2); font-size: .9rem; }
  a { color: var(--accent); }
  /* Charts are rendered on a light background; give them a light card in dark mode too. */
  figure { margin: 12px 0; background: #fcfcfb; border: 1px solid var(--border); border-radius: 8px;
           padding: 8px; overflow-x: auto; }
  figure img { display: block; max-width: 100%; height: auto; }
  figcaption { color: #52514e; font-size: .85rem; padding: 6px 4px 0; }
  .table-wrap { overflow-x: auto; }
  table { border-collapse: collapse; width: 100%; font-size: .88rem; font-variant-numeric: tabular-nums; }
  th, td { text-align: left; padding: 6px 10px; border-bottom: 1px solid var(--border); white-space: nowrap; }
  th { color: var(--text-2); font-weight: 600; background: var(--surface-2); }
  ul.findings li { margin-bottom: 8px; }
  .note { background: var(--surface-2); border-left: 3px solid var(--accent); padding: 10px 14px;
          border-radius: 4px; color: var(--text-2); font-size: .9rem; }
  .stats { display: flex; flex-wrap: wrap; gap: 12px; margin: 16px 0; }
  .stat { background: var(--surface-2); border-radius: 8px; padding: 10px 16px; min-width: 140px; }
  .stat b { display: block; font-size: 1.3rem; }
  .stat span { color: var(--text-2); font-size: .82rem; }
</style>
</head>
<body><main>
{% block body %}{% endblock %}
<p class="meta" style="margin-top:48px">Generated {{ generated }} by <code>python -m lab.reports</code>.
Data: CDC ILINet via the Delphi Epidata <code>fluview</code> endpoint. All text is templated from computed numbers.</p>
</main></body>
</html>
